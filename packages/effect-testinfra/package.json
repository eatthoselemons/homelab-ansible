{
  "name": "effect-testinfra",
  "version": "0.1.0",
  "description": "Effect-based infrastructure testing library",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "effect": "^3.7.0",
    "@effect/schema": "^0.72.0",
    "@effect/platform": "^0.63.0",
    "@effect/platform-node": "^0.58.0",
    "node-ssh": "^13.2.0"
  },
  "devDependencies": {
    "@effect/vitest": "^0.9.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
